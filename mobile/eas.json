{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "store-media": {
      "extends": "screenshots",
      "config": "store-media.yml"
    },
    "store-media-reuse": {
      "extends": "screenshots",
      "config": "store-media-reuse.yml"
    },
    "screenshots-reuse": {
      "extends": "screenshots",
      "config": "screenshots-reuse.yml"
    },
    "screenshots": {
      "withoutCredentials": true,
      "distribution": "internal",
      "config": "screenshots.yml",
      "ios": {
        "simulator": true,
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815057736",
        "metadataPath": "./store.config.js"
      }
    }
  }
}
