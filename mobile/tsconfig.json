{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "types": [
      "node",
      "react"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../game/spells.js",
    "../game/tilt.js",
    "../firebase-config.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
